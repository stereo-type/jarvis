JARVIS_BOT_TOKEN=
JARVIS_ALLOWED_USER_IDS=
# Числовые Telegram ID редакторов, через запятую. Добавьте их также в whitelist.
JARVIS_ADMIN_USER_IDS=
JARVIS_DB_PASSWORD=
JARVIS_PORT=8080
JARVIS_CINEMA_ENABLED=false
JARVIS_PUBLIC_URL=https://jarvis.ai.kilop.ru
# Числовой ID бота Filmobot (число перед двоеточием в его токене).
JARVIS_FILMOBOT_ID=
# @username для первого контакта с Filmobot.
JARVIS_FILMOBOT_USERNAME=
# Случайный секрет webhook, 16–256 символов A-Z, a-z, 0-9, "_" или "-".
JARVIS_CINEMA_WEBHOOK_SECRET=
# Только для nginx в Docker, при подключении compose.proxy.yaml:
# JARVIS_PROXY_NETWORK=имя-сети-nginx
