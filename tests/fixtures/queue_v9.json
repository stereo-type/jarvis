    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst allTasks = items.map(i => i.json).filter(t => t.ID);\nconst allProjects = $('Read Projects').all().map(i => i.json).filter(p => p.ID);\n\nconst maxParallel = parseInt($env.MAX_PARALLEL_TASKS) || 2;\n\n// Only top-level tasks enter the queue; sub-tasks are executed as part of their parent\nconst topLevelTasks = allTasks.filter(t => !t.ParentTaskID);\n\n// Reset RATE_LIMITED tasks whose RetryAfter has passed\nconst now = Date.now();\nfor (const t of topLevelTasks) {\n  if ((t.Status || '').toUpperCase() !== 'RATE_LIMITED') continue;\n  if (!t.RetryAfter) continue;\n  if (new Date(t.RetryAfter).getTime() <= now) {\n    t.Status = t.PreviousStatus || 'NEW';\n  }\n}\n\n\n// Track IN_PROGRESS count per project (only top-level)\nconst inProgressByProject = {};\ntopLevelTasks.filter(t => (t.Status || '').toUpperCase() === 'IN_PROGRESS').forEach(t => {\n  const pid = t.ProjectID || '__default__';\n  inProgressByProject[pid] = (inProgressByProject[pid] || 0) + 1;\n});\n\nconst readyTasks = [];\nfor (const t of topLevelTasks) {\n  const status = (t.Status || '').toUpperCase();\n  if (status !== 'NEW' && status !== 'NEEDS_REVISION') continue;\n  const pid = t.ProjectID || '__default__';\n\n  // Per-project parallel limit\n  const projectInProgress = inProgressByProject[pid] || 0;\n  if (projectInProgress >= maxParallel) continue;\n\n  // Project-aware DependsOn: deps only block within same project, top-level only\n  if (t.DependsOn) {\n    const deps = t.DependsOn.split(',').map(d => d.trim()).filter(d => d);\n    const sameProjectCompleted = new Set(\n      topLevelTasks\n        .filter(dep =>\n          (dep.ProjectID || '__default__') === pid &&\n          ['DONE', 'IN_REVIEW', 'WAITING_MERGE'].includes((dep.Status || '').toUpperCase())\n        )\n        .map(dep => dep.ID)\n    );\n    if (!deps.every(depId => sameProjectCompleted.has(depId))) continue;\n  }\n\n  readyTasks.push(t);\n  inProgressByProject[pid] = (inProgressByProject[pid] || 0) + 1;\n}\n\nif (readyTasks.length === 0) {\n  return [{ json: { skip: true, reason: 'No ready tasks' } }];\n}\n\nreturn readyTasks.map(t => ({ json: { ...t, skip: false } }));"
      },
