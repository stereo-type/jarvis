    {
      "parameters": {
        "jsCode": "const task = $('Filter Ready Tasks').item.json;\nconst startDatetime = $input.first().json.StartDatetime || new Date().toISOString();\n\n// Look up project config\nconst allProjects = $('Read Projects').all().map(i => i.json).filter(p => p.ID);\nconst project = allProjects.find(p => p.ID === task.ProjectID) || {};\nconst token = project.TokenEnvVar ? ($env[project.TokenEnvVar] || '') : ($env.GITHUB_TOKEN || '');\n\n// Include sub-tasks as a checklist for the coder\nconst allTasks = $('Read All Tasks').all().map(i => i.json).filter(t => t.ID);\nconst subTasks = allTasks\n  .filter(t => t.ParentTaskID === task.ID)\n  .map(t => ({ id: t.ID, title: t.Title, description: t.Description || '' }));\n\nreturn [{ json: {\n  taskId:          task.ID,\n  taskTitle:       task.Title,\n  taskDescription: task.Description,\n  chatId:          task.ChatID || '',\n  startDatetime:   startDatetime,\n  projectId:       task.ProjectID || '',\n  platform:        project.Platform || 'github',\n  owner:           project.Owner || $env.GITHUB_OWNER,\n  repo:            project.Repo || task.Repo || $env.PROJECT_REPO,\n  baseUrl:         project.BaseUrl || '',\n  token:           token,\n  subTasks:        subTasks,\n  ...((task.Status || '').toUpperCase() === 'NEEDS_REVISION' && task.ReviewerComment\n    ? { reviewComment: task.ReviewerComment }\n    : {})\n} }];"
      },
